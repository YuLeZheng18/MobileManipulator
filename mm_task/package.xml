<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mm_task</name>
  <version>0.0.0</version>
  <description>顶层任务状态机:串联初始化定位→导航→对位→抓取→放托盘→搬运全流程。</description>
  <maintainer email="a2715187136@qq.com">fishros</maintainer>
  <license>MIT</license>

  <!-- mission_manager 只做编排: 发话题 / 调 Trigger 服务 / 设参数 / 查 TF.
       几何与运动规划全在 mm_grasp 的 C++ grasp_node 里, 故不依赖 moveit/pymoveit2;
       导航也只发 /go_to 给 lane_navigator, 不直接调 Nav2 action. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
