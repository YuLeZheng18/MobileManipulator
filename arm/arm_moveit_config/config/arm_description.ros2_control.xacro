<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- hw: mock = mock_components(纯RViz假硬件); real = 实车 topic_based(CAN桥接) -->
    <xacro:macro name="arm_description_ros2_control" params="name initial_positions_file hw:=^mock">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${hw == 'real'}">
                    <!-- 实车: JTC 把 100Hz 稠密位置流发到 joint_commands_topic, CAN桥接节点订阅发0xFD;
                         桥接节点读CAN反馈发到 joint_states_topic 供闭环. 名字映射 Joint_11~16<->电机1~6 在桥接节点里做. -->
                    <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
                    <param name="joint_commands_topic">/arm_joint_commands</param>
                    <param name="joint_states_topic">/arm_joint_states</param>
                </xacro:if>
                <xacro:unless value="${hw == 'real'}">
                    <!-- mock: 仅 RViz 演示, 无物理 -->
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:unless>
            </hardware>
            <!-- velocity 命令接口不是给驱动发速度指令用的(0xFD 吃的是位置 + 速度上限),
                 而是为了让 TopicBasedSystem 把 JTC 算出的速度填进 /arm_joint_commands
                 的 velocity 字段 —— 它只在**声明了 velocity 命令接口**时才填, 否则该字段是空的,
                 can_bridge 就只能自己差分位置去估速度(把 JTC 已知的量丢掉再估回来)。
                 can_bridge 用这个速度前馈进 0xFD 速度字段, 替代原先每帧恒发巡航值。
                 JTC command_interfaces=[position, velocity] 是合法组合, 开环双写, 不需要 PID。 -->
            <joint name="Joint_11">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint_11']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint_12">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint_12']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint_13">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint_13']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint_14">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint_14']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint_15">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint_15']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint_16">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint_16']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
