<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mm_grasp</name>
  <version>0.0.0</version>
  <description>S4 三段抓取执行器: 粗定位(MoveIt) + 精修(moveit_servo 视觉伺服) + 末段相对直插. 被 mm_task 状态机调用, 不是状态机本身.</description>
  <maintainer email="a2715187136@qq.com">fishros</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_servo</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>ros2launch</exec_depend>

  <!-- 手柄双模式遥控节点 joy_arm_teleop.py.
       ⚠️ 刻意**不**依赖 mm_bringup: 那边已 exec_depend mm_grasp, 反向加就成环,
       colcon 会拒绝解析构建顺序。故起它的 teleop_full.launch.py 放在 mm_bringup
       (聚合总包本就该单向依赖各功能包), 本包只出节点。 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
