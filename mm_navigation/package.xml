<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mm_navigation</name>
  <version>0.0.0</version>
  <description>Mobile Manipulator Navigation Package</description>
  <maintainer email="a2715187136@qq.com">fishros</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- lane_navigator: 整张车道图的 RViz 叠加 (节点球 + 边线 + 名字) -->
  <exec_depend>visualization_msgs</exec_depend>
  <!-- scan_filter.launch.py: 砍雷达自遮挡扇区 (/scan -> /scan_filtered) -->
  <exec_depend>laser_filters</exec_depend>
  <!-- twist_mux.yaml: Nav2 与手柄共用 /cmd_vel 的优先级仲裁 -->
  <exec_depend>twist_mux</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
